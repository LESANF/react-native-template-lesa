.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# hot-updater 플러그인이 prebuild마다 다시 만든다 (KR/JP도 ignore)
fingerprint.json

# hot-updater 번들 빌드 산출물
.hot-updater/output

# test / build 산출물
coverage/
build/
.gradle/

# local tooling / generated indexes (not part of the template)
.codegraph/
.omo/
docs/superpowers/

# @bacons/apple-targets 가 prebuild 때 다시 쓴다 — 산출물
targets/**/generated.entitlements
