{
  "name": "lesa-expo-template",
  "main": "index.js",
  "version": "0.0.12",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-edge-to-edge"
        ]
      }
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "[ -f .env ] || cp .env.example .env",
    "start": "expo start",
    "prebuild": "cross-env EXPO_NO_GIT_STATUS=1 expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run test",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run start",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run android",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run android",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run android",
    "ios:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run ios",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run ios",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run ios",
    "ios:release": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 expo run:ios --configuration Release",
    "android:release": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 expo run:android --variant release",
    "icons:tabs": "sh scripts/gen-tab-icons.sh",
    "ota:deploy:ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview node scripts/ota-deploy.mjs ios",
    "ota:deploy:android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview node scripts/ota-deploy.mjs android",
    "ota:deploy:ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production node scripts/ota-deploy.mjs ios",
    "ota:deploy:android:production": "cross-env EXPO_PUBLIC_APP_ENV=production node scripts/ota-deploy.mjs android",
    "ota:fingerprint": "hot-updater fingerprint create",
    "ota:app-version": "hot-updater app-version",
    "prepare": "husky",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.6",
    "@expo/metro-runtime": "~58.0.15",
    "@hot-updater/react-native": "1.1.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@suspensive/react": "^3.21.4",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.5.11",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-network-logger": "^3.0.0",
    "react-native-notify-kit": "^10.9.1",
    "react-native-permissions": "^5.6.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "^3.4.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@hot-updater/aws": "1.1.3",
    "@hot-updater/expo": "1.1.3",
    "@hot-updater/standalone": "1.1.3",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/semver": "^7.8.0",
    "app-icon-badge": "^0.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "hot-updater": "1.1.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-native-svg-transformer": "^1.5.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
